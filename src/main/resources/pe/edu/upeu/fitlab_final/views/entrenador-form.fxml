<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="18" prefWidth="520" fx:controller="pe.edu.upeu.fitlab_final.controller.EntrenadorFormController" stylesheets="@style.css" styleClass="form">
    <padding>
        <Insets top="26" right="26" bottom="26" left="26"/>
    </padding>
    <Label text="Datos de entrenador" styleClass="section-title"/>
    <Separator/>
    <GridPane hgap="18" vgap="14">
        <columnConstraints>
            <ColumnConstraints prefWidth="120"/>
            <ColumnConstraints prefWidth="290" hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Nombres" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Apellidos" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtApellidos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="DNI" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDni" promptText="8 dígitos" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Especialidad" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEspecialidad" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Turno" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbxTurno" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancel" cancelButton="true"/>
        <Button text="Guardar" onAction="#handleSave" defaultButton="true" styleClass="primary"/>
    </HBox>
</VBox>
